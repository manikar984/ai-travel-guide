# AI Travel Guide configuration
# IMPORTANT: never commit your real API keys to GitHub or share them publicly.

GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
MURF_API_KEY=PASTE_YOUR_MURF_API_KEY_HERE

# Current Gemini model used by this package.
GEMINI_MODEL=gemini-3.6-flash

# Global automatically routes to the nearest Murf region.
# For India you can use:
# MURF_BASE_URL=https://in.api.murf.ai
MURF_BASE_URL=https://global.api.murf.ai
